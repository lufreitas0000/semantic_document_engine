# .coveragerc
[run]
# Tracks branching logic (if/else paths) as well as straight lines
branch = True
omit =
    # Do not track coverage for pure static Protocols
    semantic_engine/core_interfaces/uow.py
    # Do not track coverage for physical ML adapters (prevents downloading weights in CI)
    semantic_engine/infrastructure/ml/sentence_transformer.py

[report]
# Tell the tracer to ignore these specific AST patterns
exclude_lines =
    pragma: no cover
    def __repr__
    if TYPE_CHECKING:
    # Ignore Protocol method bodies
    \.\.\.
